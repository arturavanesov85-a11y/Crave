{
  "name": "crave",
  "private": true,
  "scripts": {
    "dev": "npm run db:prepare && next dev -p 3000",
    "build": "prisma generate && next build",
    "start": "next start -p 3000",
    "db:prepare": "node scripts/ensure-env.mjs && prisma db push --skip-generate && tsx prisma/seed.ts",
    "db:reset": "tsx prisma/reset.ts",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "proto": "node prototypes/serve.mjs",
    "postinstall": "node scripts/ensure-env.mjs && prisma generate"
  },
  "dependencies": {
    "@prisma/client": "^6.1.0",
    "next": "^15.1.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "@types/react": "^19.0.2",
    "@types/react-dom": "^19.0.2",
    "prisma": "^6.1.0",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "vitest": "^2.1.8"
  },
  "allowScripts": {
    "prisma@6.19.3": true,
    "@prisma/client@6.19.3": true,
    "@prisma/engines@6.19.3": true,
    "esbuild@0.28.2": true,
    "esbuild@0.21.5": true
  }
}
