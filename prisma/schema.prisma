// CRAVE: сайты и CRM. Суммы — целые копейки. Время — UTC, показ в Europe/Moscow.
// Для PostgreSQL: provider = "postgresql" и DATABASE_URL на сервер.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

// ---------- Доступ ----------

model User {
  id           String    @id @default(cuid())
  email        String    @unique
  fullName     String
  passwordHash String
  role         String // owner | rental_head | rental_manager | handover | finance | sales_head | sales_staff | service_staff | tech_admin
  perms        String? // JSON: индивидуальные права; пусто — права роли
  directions   String? // JSON: индивидуальные направления; пусто — направления роли
  isActive     Boolean   @default(true)
  deletedAt    DateTime? // удалённый сотрудник: скрыт, но имя остаётся в истории
  createdAt    DateTime  @default(now())
  sessions     Session[]
}

model Session {
  id        String   @id // sha256 токена
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  createdAt DateTime @default(now())
}

// ---------- Клиенты и обращения ----------

model Customer {
  id          String              @id @default(cuid())
  fullName    String
  phone       String              @unique // только цифры, 7XXXXXXXXXX
  email       String?
  birthDate   DateTime?
  drivingSince DateTime? // дата начала водительского стажа
  isForeign   Boolean             @default(false)
  notes       String?
  telegramChatId String? // клиентский бот: чат, куда слать подтверждения и акты
  createdAt   DateTime            @default(now())
  updatedAt   DateTime?
  directions  CustomerDirection[]
  documents   CustomerDocument[]
  orders      RentalOrder[]
  leads       Lead[]

  @@index([telegramChatId])
}

model CustomerDirection {
  customerId String
  direction  String // rental | sales | service
  customer   Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)
  createdAt  DateTime @default(now())

  @@id([customerId, direction])
}

model Lead {
  id             String    @id @default(cuid())
  direction      String // rental | sales | service
  site           String
  kind           String // booking_request | callback | purchase | service_request
  status         String    @default("new") // new | in_progress | converted | rejected | spam
  name           String
  phone          String
  message        String?
  payload        String? // JSON
  utm            String? // JSON
  idempotencyKey String?   @unique
  customerId     String?
  customer       Customer? @relation(fields: [customerId], references: [id])
  assigneeId     String?
  orderId        String?
  // Рабочая зона продаж и сервиса
  stage          String    @default("new")
  nextActionAt   DateTime? // когда связаться / следующее действие
  nextAction     String?
  appointmentAt  DateTime? // сервис: время записи
  saleCarId      String? // продажи: автомобиль из наличия
  carInfo        String? // автомобиль клиента или желаемый
  amount         Int? // сумма сделки или оценка работ, копейки
  lostReason     String?
  closedAt       DateTime?
  createdAt      DateTime  @default(now())
  notes          LeadNote[]
}

model LeadNote {
  id        String   @id @default(cuid())
  leadId    String
  lead      Lead     @relation(fields: [leadId], references: [id], onDelete: Cascade)
  authorId  String?
  kind      String   @default("comment") // comment | stage | system
  text      String
  createdAt DateTime @default(now())
}

// ---------- Автопарк и тарифы ----------

model Vehicle {
  id             String            @id @default(cuid())
  slug           String            @unique
  make           String
  model          String
  title          String
  year           Int
  bodyType       String // sedan | suv | coupe | pickup | minivan | wagon
  powerHp        Int
  accel          String
  drive          String
  fuel           String
  seats          Int?
  colorExterior  String?
  colorInterior  String?
  description    String?
  equipment      String? // JSON-массив строк
  photos         String? // JSON-массив путей к фото, первое — обложка
  vin            String?
  plate          String?
  avito          String? // JSON: поколение, модификация и комплектация по каталогу Авито
  mileageKm      Int               @default(0)
  condition      String            @default("ready") // ready | preparing | maintenance | unavailable
  nextServiceKm  Int?
  nextServiceAt  DateTime?
  isPublished    Boolean           @default(true)
  sortOrder      Int               @default(0)
  legacyPath     String?
  createdAt      DateTime          @default(now())
  tariffs        TariffPlan[]
  occupancies    Occupancy[]
  orders         RentalOrder[]
  documents      VehicleDocument[]
  damages        Damage[]
}

model VehicleDocument {
  id         String    @id @default(cuid())
  vehicleId  String
  vehicle    Vehicle   @relation(fields: [vehicleId], references: [id], onDelete: Cascade)
  kind       String // sts | osago | kasko | diagnostic_card | other
  title      String
  validUntil DateTime?
  createdAt  DateTime  @default(now())
}

model TariffPlan {
  id               String   @id @default(cuid())
  vehicleId        String
  vehicle          Vehicle  @relation(fields: [vehicleId], references: [id], onDelete: Cascade)
  validFrom        DateTime @default(now())
  status           String   @default("active") // active | archived
  tiers            String // JSON [{minDays, dailyRate}] — копейки
  deposit          Int
  includedKmPerDay Int
  overmileagePerKm Int
  driverPerHour    Int?
  driverOnly       Boolean  @default(false) // только почасово с водителем (от 4 ч), без посуточной аренды
  note             String?
  createdById      String?
  createdAt        DateTime @default(now())
}

model PricingRule {
  key       String   @id
  value     String // JSON
  status    String   @default("assumption") // assumption | approved
  title     String
  updatedAt DateTime @updatedAt
}

model ExtraService {
  code     String  @id
  name     String
  pricing  String // fixed | per_day | per_hour
  amount   Int? // null — цена не утверждена, услугу нельзя выбрать
  isActive Boolean @default(true)
}

// ---------- Бронирование ----------

// Единственный источник правды о занятости машины.
model Occupancy {
  id           String       @id @default(cuid())
  vehicleId    String
  vehicle      Vehicle      @relation(fields: [vehicleId], references: [id])
  kind         String // hold | booking | rental | maintenance | block
  orderId      String?
  order        RentalOrder? @relation(fields: [orderId], references: [id])
  startsAt     DateTime
  endsAt       DateTime
  blockedUntil DateTime // endsAt + буфер подготовки
  expiresAt    DateTime? // только hold
  releasedAt   DateTime?
  note         String?
  createdById  String?
  createdAt    DateTime     @default(now())

  @@index([vehicleId, startsAt])
}

// ---------- Заказы ----------

model RentalOrder {
  id             String        @id @default(cuid())
  number         String        @unique
  status         String // new | negotiation | confirmed | issued | returned | closed | cancelled | no_show
  customerId     String
  customer       Customer      @relation(fields: [customerId], references: [id])
  vehicleId      String
  vehicle        Vehicle       @relation(fields: [vehicleId], references: [id])
  leadId         String?
  pickupAt       DateTime
  returnAt       DateTime
  actualPickupAt DateTime?
  actualReturnAt DateTime?
  assigneeId     String?
  handoverId     String?
  termsSnapshot  String // JSON: тариф и правила на момент согласования
  quoteSnapshot  String // JSON: расчёт
  services       String        @default("[]") // JSON [{code, qty}]
  cancelReason   String?
  closedAt       DateTime?
  depositReleaseAt DateTime? // когда вернуть остаток залога (после проверки штрафов)
  source         String        @default("crm") // site | crm
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt
  occupancies    Occupancy[]
  events         OrderEvent[]
  comments       OrderComment[]
  inspections    Inspection[]
  ledger         LedgerEntry[]
}

model OrderEvent {
  id        String      @id @default(cuid())
  orderId   String
  order     RentalOrder @relation(fields: [orderId], references: [id], onDelete: Cascade)
  type      String
  text      String
  actorId   String?
  createdAt DateTime    @default(now())
}

model OrderComment {
  id        String      @id @default(cuid())
  orderId   String
  order     RentalOrder @relation(fields: [orderId], references: [id], onDelete: Cascade)
  authorId  String
  body      String
  createdAt DateTime    @default(now())
}

// ---------- Осмотры ----------

model Inspection {
  id          String           @id @default(cuid())
  orderId     String
  order       RentalOrder      @relation(fields: [orderId], references: [id])
  kind        String // pickup | return
  performedBy String
  performedAt DateTime         @default(now())
  mileageKm   Int
  fuelPercent Int
  checklist   String // JSON
  notes       String?
  photos      InspectionPhoto[]
  damages     Damage[]
}

model InspectionPhoto {
  id           String     @id @default(cuid())
  inspectionId String
  inspection   Inspection @relation(fields: [inspectionId], references: [id], onDelete: Cascade)
  path         String
  mime         String
  caption      String? // фото повреждения: «Передний бампер — скол»
  createdAt    DateTime   @default(now())
}

// Фото документов клиента (паспорт, права). Закрытое хранилище, доступ — право «Документы клиентов».
model CustomerDocument {
  id         String   @id @default(cuid())
  customerId String
  customer   Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)
  kind       String // passport | license | other
  path       String
  mime       String
  uploadedBy String
  createdAt  DateTime @default(now())
}

// Отправленные уведомления в Telegram: ключ не даёт прислать одно и то же дважды.
model Notification {
  key       String   @id // например «rem-pickup:<orderId>»
  sentAt    DateTime @default(now())
}

model Damage {
  id           String      @id @default(cuid())
  vehicleId    String
  vehicle      Vehicle     @relation(fields: [vehicleId], references: [id])
  inspectionId String?
  inspection   Inspection? @relation(fields: [inspectionId], references: [id])
  location     String
  description  String
  status       String      @default("open") // open | repaired
  createdAt    DateTime    @default(now())
}

// ---------- Финансы ----------

// Журнал только на добавление. Исправление — сторно (reversesId) и новая запись.
model LedgerEntry {
  id             String       @id @default(cuid())
  direction      String       @default("rental")
  kind           String // charge.rental | charge.service | charge.extra | charge.discount | payment.in | payment.refund | deposit.in | deposit.refund | deposit.withhold | expense.vehicle | expense.general
  amount         Int // копейки; сторно — с обратным знаком
  occurredAt     DateTime     @default(now())
  orderId        String?
  order          RentalOrder? @relation(fields: [orderId], references: [id])
  vehicleId      String?
  customerId     String?
  method         String? // cash | card | transfer
  basis          String
  reversesId     String?      @unique
  createdById    String
  approvedById   String?
  idempotencyKey String?      @unique
  createdAt      DateTime     @default(now())
}

model WithholdRequest {
  id           String    @id @default(cuid())
  orderId      String
  amount       Int
  basis        String
  status       String    @default("pending") // pending | approved | rejected
  requestedBy  String
  decidedBy    String?
  decidedAt    DateTime?
  createdAt    DateTime  @default(now())
}

// ---------- Журнал изменений ----------

model AuditLog {
  id        String   @id @default(cuid())
  actorId   String?
  action    String
  entity    String
  entityId  String
  details   String?
  createdAt DateTime @default(now())
}

// ---------- Автосалон ----------

// Автомобиль в продаже на сайте автосалона.
model SaleCar {
  id           String    @id @default(cuid())
  slug         String    @unique
  status       String    @default("draft") // draft | published | reserved | sold
  supply       String    @default("stock") // stock — в наличии | transit — в пути | order — под заказ
  etaAt        DateTime? // ожидаемая дата прибытия (в пути)
  etaNote      String? // срок поставки текстом: «6–8 недель»
  make         String
  model        String
  title        String
  year         Int
  mileageKm    Int       @default(0)
  price        Int? // копейки; пусто — «цена по запросу»
  priceVat     Boolean   @default(false) // цена с НДС — так и пишется в объявлении
  bodyType     String    @default("sedan")
  powerHp      Int?
  engine       String? // «бензин, 3.0 л»
  transmission String?
  drive        String?
  color        String? // цвет кузова
  colorInterior String? // цвет салона
  description  String?
  equipment    String? // JSON-массив строк
  photos       String? // JSON-массив путей, первое — обложка
  vin          String?
  note         String? // внутренняя заметка, на сайте не показывается
  sortOrder    Int       @default(0)
  // Авито: off — не готовится | draft — черновик в CRM, на Авито не уходит | live — в файле автозагрузки
  avitoStatus  String    @default("off")
  avito        String? // JSON: поля объявления по каталогу Авито (марка, поколение, модификация, цена…)
  avitoSince   DateTime? // когда отправлено на Авито
  createdById  String?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime?
  deals        SaleDeal[]
}

// Бронь или продажа машины из «Авто в продаже»: клиент, цена, кто оформил.
// Активная сделка у машины одна; при «Вернуть в продажу» она отменяется, но остаётся в истории.
model SaleDeal {
  id            String    @id @default(cuid())
  saleCarId     String
  saleCar       SaleCar   @relation(fields: [saleCarId], references: [id], onDelete: Cascade)
  kind          String // reserved — бронь | sold — продажа
  status        String    @default("active") // active | done — бронь перешла в продажу | cancelled
  customerId    String?
  clientName    String
  clientPhone   String // только цифры, 7XXXXXXXXXX
  price         Int // копейки
  priceVat      Boolean   @default(false)
  buyer         String? // JSON: паспортные данные покупателя для ДКП
  note          String?
  managerId     String // кто поставил бронь или продажу
  createdAt     DateTime  @default(now())
  closedAt      DateTime?
  closedById    String?

  @@index([saleCarId, status])
}

// Редактируемые тексты сайтов (ключ — например, auto.heroTitle).
model SiteSetting {
  key       String   @id
  value     String
  updatedBy String?
  updatedAt DateTime @updatedAt
}

// Услуги сервиса для сайта crave-service.ru.
model ServiceItem {
  id          String   @id @default(cuid())
  name        String
  description String?
  priceFrom   Int? // копейки; пусто — «по запросу»
  sortOrder   Int      @default(0)
  isPublished Boolean  @default(true)
  createdAt   DateTime @default(now())
}

// Привязка аккаунта Telegram к сотруднику (вход в мини-приложение). Подтверждает владелец.
model TelegramLink {
  id          String    @id @default(cuid())
  telegramId  String    @unique
  username    String?
  firstName   String?
  lastName    String?
  status      String    @default("pending") // pending | approved | rejected
  userId      String?
  decidedBy   String?
  decidedAt   DateTime?
  lastSeenAt  DateTime?
  blockedAt   DateTime? // бот не может писать этому человеку (не разрешил или заблокировал)
  createdAt   DateTime  @default(now())
}

// Файлы документов автомобиля (ПТС, СТС, полисы, договоры…) — для машин проката и машин в продаже.
// Хранятся в закрытом storage/cars/…, отдаются через /api/files/car/[id] после проверки прав.
model CarFile {
  id         String   @id @default(cuid())
  carType    String // vehicle — автопарк проката | salecar — авто в продаже
  carId      String
  kind       String // pts | sts | osago | kasko | contract | diagnostic | other
  title      String // имя файла или подпись
  path       String
  mime       String
  size       Int
  uploadedBy String
  createdAt  DateTime @default(now())

  @@index([carType, carId])
}
