# База данных. Для PostgreSQL: provider = "postgresql" в prisma/schema.prisma и строка подключения сюда.
DATABASE_URL="file:./dev.db"
# Пароль тестовых пользователей при первом заполнении базы.
SEED_PASSWORD="crave-test"

# Домены на сервере (локально оставьте закомментированными — сайты откроются по путям /auto и /service).
# Задаются до сборки (npm run build).
# NEXT_PUBLIC_SITE_ORIGIN="https://crave-rental.ru"
# NEXT_PUBLIC_URL_RENTAL="https://crave-rental.ru"
# NEXT_PUBLIC_URL_AUTO="https://crave-auto.ru"
# NEXT_PUBLIC_URL_SERVICE="https://crave-service.ru"
# SITE_HOST_AUTO="crave-auto.ru"
# SITE_HOST_SERVICE="crave-service.ru"

# Мини-приложение Telegram для сотрудников (см. README, «Мини-приложение Telegram»).
# Токен выдаёт @BotFather. Не публикуйте его и не коммитьте .env.
# TELEGRAM_BOT_TOKEN=""
# TELEGRAM_BOT_USERNAME="crave_staff_bot"
